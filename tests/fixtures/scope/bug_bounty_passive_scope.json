{
  "schema_version": "belief.scope.v1",
  "name": "bug-bounty-passive-example",
  "mode": "bug-bounty-passive",
  "include": ["https://app.example.test", "tests/fixtures/sample_app"],
  "exclude": ["https://admin.example.test"],
  "rules": {
    "allow_network": false,
    "allow_dynamic": false,
    "allow_active_scan": false,
    "allow_fuzzing": false,
    "allow_auth_tests": false,
    "max_requests_per_second": 0,
    "timeout_seconds": 180
  },
  "redaction": {
    "cookies": true,
    "authorization": true,
    "tokens": true,
    "secrets": true
  }
}
