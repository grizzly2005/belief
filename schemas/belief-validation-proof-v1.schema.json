{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/belief/schemas/belief-validation-proof-v1.schema.json",
  "title": "BELIEF Validation Proof v1",
  "type": "object",
  "required": [
    "schema_version",
    "proof_id",
    "engagement_id",
    "target_id",
    "subject_id",
    "subject_kind",
    "plan_id",
    "attempt_id",
    "result_id",
    "outcome",
    "oracle_id",
    "oracle_version",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {"const": "belief.validation_proof.v1"},
    "proof_id": {"type": "string", "pattern": "^vproof_[0-9a-f]{24}$"},
    "engagement_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "target_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "subject_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "subject_kind": {"type": "string", "minLength": 1, "maxLength": 512},
    "plan_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "attempt_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "result_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "outcome": {
      "type": "string",
      "enum": [
        "bypassed",
        "validated_candidate",
        "inconclusive",
        "enforced",
        "false_positive",
        "informational",
        "unknown"
      ]
    },
    "oracle_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "oracle_version": {"type": "string", "minLength": 1, "maxLength": 512},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["evidence_id", "kind", "sha256", "media_type"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1, "maxLength": 512},
          "kind": {
            "type": "string",
            "enum": ["request", "response", "observation", "oracle", "log", "artifact"]
          },
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "media_type": {"type": "string", "minLength": 1, "maxLength": 255}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
