{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/belief/schemas/belief-reasoning-v1.schema.json",
  "title": "BELIEF ReasoningResponse v1",
  "type": "object",
  "required": ["schema_version", "case_id", "recommendation", "rationale_summary", "source_engine"],
  "properties": {
    "schema_version": {"const": "belief.reasoning.v1"},
    "case_id": {"type": "string"},
    "recommendation": {
      "type": "string",
      "enum": ["keep", "lower_confidence", "needs_manual_validation", "likely_false_positive", "protected_by_guard", "request_more_evidence"]
    },
    "rationale_summary": {"type": "string"},
    "suggested_missing_evidence": {"type": "array", "items": {"type": "string"}},
    "suggested_validation_steps": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "source_engine": {"type": "string"},
    "safety_notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
