{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/belief/schemas/belief-validation-result-v1.schema.json",
  "title": "BELIEF ValidationResult v1",
  "type": "object",
  "required": ["schema_version", "result_id", "subject_id", "subject_kind", "source", "outcome"],
  "properties": {
    "schema_version": {"const": "belief.validation_result.v1"},
    "result_id": {"type": "string"},
    "subject_id": {"type": "string"},
    "subject_kind": {"type": "string"},
    "source": {"type": "string"},
    "outcome": {
      "type": "string",
      "enum": ["bypassed", "validated_candidate", "inconclusive", "enforced", "false_positive", "informational", "unknown"]
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "tested": {"type": "boolean"},
    "human_validated": {"type": "boolean"},
    "method": {"type": "string"},
    "reason": {"type": "string"},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "metadata": {"type": "object"}
  },
  "additionalProperties": true
}
