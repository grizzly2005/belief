{
  "tool_id": "threat_dragon",
  "name": "OWASP Threat Dragon",
  "repo": "https://github.com/OWASP/threat-dragon",
  "license": "UNKNOWN - verify upstream before vendoring",
  "description": "Simple threat-model JSON exporter for access hypotheses and observations.",
  "execution_mode": "recipe_export",
  "command": null,
  "default_args": [],
  "input_types": ["AccessHypothesis", "AccessObservation"],
