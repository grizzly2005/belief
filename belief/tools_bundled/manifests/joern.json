  "risk": {
    "network": false,
    "active_scanning": false,
    "replays_requests": false,
    "fuzzing": false,
    "executes_target_code": false,
    "writes_files": true,
    "requires_auth_tokens": false,
    "external_services": false,
    "safe_default": true
  },
  "notes": "MVP does not generate CPGs or run heavy Joern analysis."
}
