{
  "tool_id": "joern",
  "name": "Joern",
  "repo": "https://github.com/joernio/joern",
  "license": "UNKNOWN - verify upstream before vendoring",
  "description": "Availability check and tolerant passive JSON import placeholder for Joern-derived findings.",
  "execution_mode": "passive_import",
  "command": "joern",
  "default_args": [],
  "input_types": ["joern_json"],
  "output_types": ["ExternalFinding"],
  "capabilities": ["cpg", "dataflow_import"],
