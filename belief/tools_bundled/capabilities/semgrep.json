{
  "tool_id": "semgrep",
  "name": "Semgrep",
  "category": "static",
  "input_types": ["local_path"],
  "output_formats": ["json"],
  "languages": ["python", "javascript", "typescript", "go", "java", "ruby", "php"],
  "capabilities": ["static_analysis"],
  "requires_network": false,
  "requires_dynamic": false,
  "requires_scope": false,
  "can_run_local": true,
  "can_import_only": true,
  "risk_level": "low",
  "default_timeout_seconds": 180,
  "profiles": ["local-safe", "appsec-local", "bug-bounty-passive"],
  "run_command_template": ["semgrep", "scan", "--json", "--config", "auto", "{target}"],
  "import_format": "semgrep_json",
  "normalized_output_name": "semgrep.belief-tools.json",
  "safety_notes": ["Optional local static scanner."]
}
