# BELIEF — Groq API keys for rotation pool
# Copy this file to `.env` (NOT committed) and fill in your actual keys.
# The pool uses GROQ_API_KEY as primary, and GROQ_API_KEY_2..10 as extras.

GROQ_API_KEY=gsk_your_primary_key_here

# Optional extras — leave blank if unused
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=

# Other BELIEF settings (if not set elsewhere)
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
